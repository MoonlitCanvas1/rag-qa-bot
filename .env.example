# Required for `query` and `chat`
ANTHROPIC_API_KEY=sk-ant-...

# Storage
CHROMA_DIR=./chroma_db
DATA_DIR=./data
COLLECTION_NAME=documents

# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=claude-sonnet-4-20250514

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval (MIN_SCORE is cosine similarity, -1..1)
TOP_K=4
MIN_SCORE=0.30

# Generation
MAX_TOKENS=1024
TEMPERATURE=0.0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
